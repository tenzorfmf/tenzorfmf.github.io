---
import { render } from 'astro:content';
import { locales, bcp47, type Locale } from '../../i18n/config';
import { t } from '../../utils/i18n';
import {
  pagesForLocale,
  postsForLocale,
  navTree,
  translationLinks,
} from '../../utils/content';
import { postPath } from '../../utils/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedItem from '../../components/content/FeaturedItem.astro';
import SectionIndex from '../../components/content/SectionIndex.astro';
import LatestList from '../../components/content/LatestList.astro';

export async function getStaticPaths() {
  const paths: { params: { lang: Locale }; props: { locale: Locale } }[] = [];
  for (const locale of locales) {
    const pages = await pagesForLocale(locale);
    if (pages.some((p) => p.data.translationKey === 'home')) {
      paths.push({ params: { lang: locale }, props: { locale } });
    }
  }
  return paths;
}

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = t(locale);

const pages = await pagesForLocale(locale);
const home = pages.find((p) => p.data.translationKey === 'home')!;
const { Content } = await render(home);
const tLinks = await translationLinks(home, 'pages');

const tree = await navTree(locale);

const SECTION_DESCRIPTORS: Record<string, Record<Locale, string>> = {
  'section-program': { sl: 'Načela in pobude', en: 'Platform & initiatives' },
  'section-finance': { sl: 'Poraba in poročila', en: 'Spending & reports' },
  'section-events': { sl: 'Prihajajoči in pretekli', en: 'Upcoming & past' },
  'section-students': { sl: 'Soba, učbeniki, povezave', en: 'Room, textbooks, links' },
  'section-about': { sl: 'Kdo smo, kontakt', en: 'Who we are, contact' },
};

const exploreItems = tree.map((n) => ({
  href: n.href,
  title: n.label,
  descriptor: SECTION_DESCRIPTORS[n.entry.data.translationKey]?.[locale],
}));

const posts = await postsForLocale(locale);
const featured = posts
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];

const latest = posts
  .filter(
    (p) =>
      p.data.search.include !== false &&
      p.data.kind !== 'archive' &&
      p.id !== featured?.id,
  )
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 5)
  .map((p) => ({
    href: postPath(p),
    title: p.data.title,
    date: p.data.publishedAt,
  }));

const featuredDate = new Intl.DateTimeFormat(bcp47[locale], {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const featuredMeta = featured
  ? `${strings.kinds[featured.data.kind]} · ${featuredDate.format(featured.data.publishedAt)}`
  : undefined;

const seoTitle = home.data.seo.title ?? 'Tenzor';
const seoDesc = home.data.seo.description ?? home.data.summary ?? '';
---

<BaseLayout
  locale={locale}
  title={seoTitle}
  description={seoDesc}
  canonicalPath={`/${locale}/`}
  translationLinks={tLinks}
  mainClass="site-main--home"
  currentPath={`/${locale}/`}
  intro
>
  <h1 class="home-title" data-reveal style="--d: 0.3s">{home.data.title}</h1>
  <div class="home-lede" lang={locale} data-reveal style="--d: 0.38s">
    <Content />
  </div>

  {
    featured && (
      <FeaturedItem
        eyebrow={strings.importantNow}
        href={postPath(featured)}
        title={featured.data.title}
        meta={featuredMeta}
        deck={featured.data.summary}
        cta={strings.readMore}
      />
    )
  }

  <SectionIndex eyebrow={strings.explore} items={exploreItems} />

  <LatestList eyebrow={strings.latest} locale={locale} items={latest} />
</BaseLayout>

<style>
  .home-title {
    margin: 0 0 18px;
    text-align: center;
    font: var(--h1-home);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .home-lede {
    margin: 0 0 34px;
  }
  .home-lede :global(p) {
    font: var(--home-lede);
    color: var(--ink);
    text-align: justify;
    hyphens: auto;
    margin: 0 0 12px;
  }

  @media (min-width: 1100px) {
    :global(.site-main--home.site-main--home) {
      max-width: calc(var(--measure-wide) + 60px);
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      column-gap: 56px;
      grid-template-areas:
        'title title'
        'lede lede'
        'featured sections'
        'latest sections';
    }
    .home-title {
      grid-area: title;
    }
    .home-lede {
      grid-area: lede;
    }
    :global(.site-main--home) > :global(.featured) {
      grid-area: featured;
    }
    :global(.site-main--home) > :global(.section-index) {
      grid-area: sections;
    }
    :global(.site-main--home) > :global(.latest) {
      grid-area: latest;
    }
  }
</style>
