---
import '@fontsource/jost/500.css';
import '@fontsource/jost/600.css';
import '@fontsource/jost/700.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/400-italic.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/open-sans/700.css';
import '../styles/tokens.css';
import '../styles/global.css';

import type { Locale } from '../i18n/config';
import { t, localeHtmlLang, site } from '../utils/i18n';
import { navTree } from '../utils/content';
import { searchPath, homePath } from '../utils/routes';
import BaseHead from '../components/shared/BaseHead.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import MenuOverlay from '../components/navigation/MenuOverlay.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import SearchDock from '../components/navigation/SearchDock.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  translationLinks?: { locale: Locale; href: string | null }[];
  currentPath?: string;
  mainClass?: string;
  wide?: boolean;
  pagefindBody?: boolean;
  pagefindFilters?: Record<string, string | string[]>;
  pagefindMeta?: Record<string, string>;
  /** Home only: run the hexagon load-in on the first visit per session. */
  intro?: boolean;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  noindex = false,
  translationLinks = [],
  currentPath = canonicalPath,
  mainClass = '',
  wide = false,
  pagefindBody = true,
  pagefindFilters = {},
  pagefindMeta = {},
  intro = false,
} = Astro.props;

// Pagefind reads one filter key per element; emit a hidden block, one line each.
const filterPairs: [string, string][] = Object.entries(pagefindFilters).flatMap(([k, v]) =>
  Array.isArray(v) ? v.map((vv) => [k, vv] as [string, string]) : [[k, String(v)] as [string, string]],
);
const metaPairs: [string, string][] = Object.entries(pagefindMeta);

const strings = t(locale);
const tree = await navTree(locale);

const domains = tree.map((n) => ({ href: n.href, label: n.label }));
const homeHref = homePath(locale);
const searchHref = searchPath(locale);

const financeNode = tree.find((n) => n.entry.data.translationKey === 'section-finance');
const contactChild = tree
  .flatMap((n) => n.children)
  .find((c) => c.entry.data.translationKey === 'contacts');
const contactHref = contactChild?.href ?? homeHref;

const utilityLinks = [
  { href: `${homeHref}#latest`, label: strings.news },
  ...(financeNode ? [{ href: financeNode.href, label: strings.documents }] : []),
  { href: contactHref, label: strings.contacts },
];

const mainClasses = ['site-main', mainClass, wide ? 'site-main--wide' : ''].filter(Boolean).join(' ');
---

<!doctype html>
<html lang={localeHtmlLang(locale)}>
  <head>
    <BaseHead
      locale={locale}
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      hreflang={translationLinks}
    />
    {
      intro && (
        <script is:inline>
          try {
            if (
              !matchMedia('(prefers-reduced-motion: reduce)').matches &&
              !sessionStorage.getItem('tenzor-intro')
            ) {
              document.documentElement.dataset.intro = 'pending';
              // Failsafe: content can never stay hidden.
              setTimeout(function () {
                delete document.documentElement.dataset.intro;
              }, 2500);
            }
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.skipToContent}</a>
    <div class="frame">
      <SiteHeader
        locale={locale}
        homeHref={homeHref}
        brandName={site.brand.name}
        domains={domains}
        currentPath={currentPath}
        translationLinks={translationLinks}
      />
      <MenuOverlay
        locale={locale}
        searchHref={searchHref}
        domains={domains}
        utilityLinks={utilityLinks}
        translationLinks={translationLinks}
      />
      <main
        id="main"
        class={mainClasses}
        {...(pagefindBody ? { 'data-pagefind-body': true } : { 'data-pagefind-ignore': true })}
      >
        {
          pagefindBody && (filterPairs.length > 0 || metaPairs.length > 0) && (
            <div hidden>
              {filterPairs.map(([k, v]) => (
                <span data-pagefind-filter={k}>{v}</span>
              ))}
              {metaPairs.map(([k, v]) => (
                <span data-pagefind-meta={k}>{v}</span>
              ))}
            </div>
          )
        }
        <slot />
      </main>
      <SiteFooter locale={locale} contactHref={contactHref} />
    </div>
    <SearchDock locale={locale} searchHref={searchHref} />
    {
      intro && (
        <script is:inline>
          (function () {
            var root = document.documentElement;
            if (!root.dataset.intro) return;
            try {
              sessionStorage.setItem('tenzor-intro', '1');
            } catch (e) {}
            var logo = document.querySelector('.site-header__mark svg');
            if (!logo) {
              root.dataset.intro = 'run';
              return;
            }
            var hex = logo.cloneNode(true);
            hex.setAttribute('class', 'intro-hex');
            hex.setAttribute('aria-hidden', 'true');
            document.body.append(hex);
            logo.style.opacity = '0';
            setTimeout(function () {
              hex.classList.add('is-in');
            }, 50);
            setTimeout(function () {
              // Fly to the real logo, measured now rather than hard-coded.
              var a = hex.getBoundingClientRect();
              var b = logo.getBoundingClientRect();
              var dx = b.left + b.width / 2 - (a.left + a.width / 2);
              var dy = b.top + b.height / 2 - (a.top + a.height / 2);
              hex.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(' + b.width / a.width + ')';
              root.dataset.intro = 'run';
            }, 850);
            setTimeout(function () {
              logo.style.opacity = '';
              hex.remove();
            }, 1460);
          })();
        </script>
      )
    }
  </body>
</html>
