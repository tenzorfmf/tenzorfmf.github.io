---
import type { Locale } from '../../i18n/config';
import { t } from '../../utils/i18n';
import LanguageToggle from './LanguageToggle.astro';

interface DomainLink {
  href: string;
  label: string;
}
interface Props {
  locale: Locale;
  searchHref: string;
  domains: DomainLink[];
  utilityLinks: DomainLink[];
  translationLinks: { locale: Locale; href: string | null }[];
}

const { locale, searchHref, domains, utilityLinks, translationLinks } = Astro.props;
const strings = t(locale);
---

<div class="menu" id="site-menu" data-menu hidden>
  <div class="menu__inner">
    <div class="menu__bar">
      <span class="menu__title">{strings.menu}</span>
      <button type="button" class="menu__close" data-menu-close aria-label={strings.closeMenu}>×</button>
    </div>

    <a class="menu__search" href={searchHref}>{strings.search}</a>

    <nav class="menu__domains" aria-label={strings.menu}>
      {
        domains.map((d) => (
          <a class="menu__domain" href={d.href}>
            <span>{d.label}</span>
            <span aria-hidden="true">›</span>
          </a>
        ))
      }
    </nav>

    {
      utilityLinks.length > 0 && (
        <div class="menu__utility">
          {utilityLinks.map((u) => (
            <a class="menu__utility-link" href={u.href}>
              {u.label}
            </a>
          ))}
        </div>
      )
    }

    <LanguageToggle locale={locale} links={translationLinks} />
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    background: var(--paper);
    z-index: 50;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu__inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 20px var(--pad);
    display: flex;
    flex-direction: column;
  }
  .menu__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }
  .menu__title {
    font: var(--menu-title);
    color: var(--ink);
  }
  .menu__close {
    background: none;
    border: none;
    font: 400 26px/1 var(--sans);
    color: var(--ink);
    cursor: pointer;
    padding: 4px 8px;
  }
  .menu__search {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    font: 500 15px/1.3 var(--sans);
    color: var(--ink);
    text-decoration: none;
  }
  .menu__domains {
    display: flex;
    flex-direction: column;
  }
  .menu__domain {
    display: flex;
    justify-content: space-between;
    padding: var(--row-menu) 0;
    border-bottom: 1px solid var(--rule);
    font: var(--menu-item);
    color: var(--ink);
    text-decoration: none;
  }
  .menu__utility {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
  }
  .menu__utility-link {
    font: 500 13px/1.3 var(--sans);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .menu__domain:hover span:first-child {
    color: var(--accent);
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (menu && toggle) {
    const FOCUSABLE =
      'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';
    let lastFocused: HTMLElement | null = null;

    const isOpen = () => !menu.hasAttribute('hidden');

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      menu.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      const first = menu.querySelector<HTMLElement>(FOCUSABLE);
      first?.focus();
      document.addEventListener('keydown', onKeydown);
    };

    const close = () => {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      (lastFocused ?? toggle).focus();
    };

    const onKeydown = (e: KeyboardEvent) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        const nodes = Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
          (n) => n.offsetParent !== null,
        );
        if (nodes.length === 0) return;
        const first = nodes[0];
        const last = nodes[nodes.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    closeBtn?.addEventListener('click', close);
  }
</script>
