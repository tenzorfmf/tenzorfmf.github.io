---
import type { Locale } from '../../i18n/config';
import { locales, localeShort, localeNames } from '../../i18n/config';
import { t } from '../../utils/i18n';

interface DomainLink {
  href: string;
  label: string;
}
interface Props {
  locale: Locale;
  homeHref: string;
  brandName: string;
  domains: DomainLink[];
  currentPath?: string;
  translationLinks?: { locale: Locale; href: string | null }[];
}

const {
  locale,
  homeHref,
  brandName,
  domains,
  currentPath = '',
  translationLinks = [],
} = Astro.props;
const strings = t(locale);
const linkByLocale = new Map(translationLinks.map((l) => [l.locale, l.href]));
const otherLocale = locales.find((l) => l !== locale) ?? locale;
const otherHref = linkByLocale.get(otherLocale) ?? null;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={homeHref} aria-label={brandName}>
      <span class="site-header__mark" aria-hidden="true">
        <svg viewBox="0 0 280 242.5" focusable="false">
          <polygon points="70,0 210,0 140,121 0,121" fill="#E6007E"></polygon>
          <polygon points="210,0 280,121 210,242.5 140,121" fill="#0090F5"></polygon>
          <polygon points="0,121 140,121 210,242.5 70,242.5" fill="#FFCE00"></polygon>
        </svg>
      </span>
      <span class="site-header__wordmark" data-reveal style="--d: 0.3s">{brandName.toUpperCase()}</span>
    </a>

    <nav class="site-header__inline" aria-label={strings.menu}>
      {
        domains.map((d) => (
          <a
            class="site-header__inline-link"
            href={d.href}
            aria-current={currentPath.startsWith(d.href) ? 'page' : undefined}
          >
            {d.label}
          </a>
        ))
      }
    </nav>

    {
      otherHref ? (
        <a
          class="site-header__langswitch"
          href={otherHref}
          hreflang={otherLocale}
          lang={otherLocale}
          aria-label={strings.switchLanguage}
          data-reveal
          style="--d: 0.3s"
        >
          {localeShort[otherLocale]}
        </a>
      ) : (
        <span
          class="site-header__langswitch site-header__langswitch--disabled"
          aria-disabled="true"
          title={`${localeNames[otherLocale]} — ${strings.translationMissing}`}
          data-reveal
          style="--d: 0.3s"
        >
          {localeShort[otherLocale]}
        </span>
      )
    }
  </div>
</header>

<style>
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--gap-logo);
    text-decoration: none;
    color: var(--ink);
  }
  .site-header__mark {
    width: 26px;
    height: 22.5px;
    flex: none;
    display: block;
  }
  .site-header__mark svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .site-header__wordmark {
    font: var(--logotype);
    letter-spacing: var(--logotype-tracking);
    color: var(--ink);
  }

  .site-header__inline {
    display: none;
  }

  .site-header__langswitch {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 36px;
    padding: 0 8px;
    background: var(--paper);
    border: 2px solid var(--ink);
    font: 700 13px/1 var(--display);
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 150ms ease, color 150ms ease;
  }
  .site-header__langswitch--disabled {
    color: var(--ink-50);
    border-color: var(--rule-chip);
    cursor: not-allowed;
  }
  a.site-header__langswitch:hover {
    color: var(--on-ink);
    background: var(--ink);
  }

  @media (min-width: 1100px) {
    .site-header {
      max-width: none;
      border-bottom: 2px solid var(--ink);
      background: var(--paper);
    }
    .site-header__inner {
      max-width: var(--measure-wide);
      margin: 0 auto;
      padding: 20px 0;
      gap: 24px;
    }
    .site-header__inline {
      display: flex;
      gap: 24px;
      align-items: center;
    }
    .site-header__inline-link {
      font: var(--subnav-tab);
      color: var(--ink);
      text-decoration: none;
      transition: color 150ms ease;
    }
    .site-header__inline-link[aria-current='page'] {
      color: var(--accent);
    }
    .site-header__inline-link:hover {
      color: var(--accent);
    }
  }
</style>
