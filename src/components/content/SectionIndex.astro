---
interface Item {
  href: string;
  title: string;
  descriptor?: string;
}
interface Props {
  eyebrow: string;
  items: Item[];
}
const { eyebrow, items } = Astro.props;
const pad2 = (n: number) => String(n).padStart(2, '0');
// CMYK strip per row, cycling magenta, cyan, yellow, ink.
const STRIPS = ['var(--magenta)', 'var(--cyan)', 'var(--yellow)', 'var(--ink)'];
---

<section class="section-index" data-reveal style="--d: 0.35s">
  <div class="eyebrow">{eyebrow}</div>
  <div class="section-index__rows">
    {
      items.map((item, i) => (
        <a href={item.href} class="section-index__row">
          <span class="section-index__strip" style={`background: ${STRIPS[i % STRIPS.length]}`} aria-hidden="true" />
          <span class="section-index__num" aria-hidden="true">{pad2(i + 1)}</span>
          <span class="section-index__text">
            <span class="section-index__title">{item.title}</span>
            {item.descriptor && <span class="section-index__desc">{item.descriptor}</span>}
          </span>
          <span class="section-index__arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .section-index {
    margin-bottom: var(--sec-home);
  }
  .section-index__rows {
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }
  .section-index__row {
    display: flex;
    align-items: center;
    gap: var(--gap-index-row);
    padding: var(--row-index) 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .section-index__strip {
    width: 6px;
    align-self: stretch;
    margin-left: 2px;
    flex: none;
  }
  .section-index__num {
    font: var(--explore-numeral);
    color: var(--ink-60);
    width: 18px;
    flex: none;
  }
  .section-index__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .section-index__title {
    font: var(--explore-item);
    transition: color 150ms ease;
  }
  .section-index__desc {
    font: 400 12.5px/1.4 var(--sans);
    color: var(--ink-60);
  }
  .section-index__arrow {
    font: 600 16px/1 var(--display);
    padding-right: 4px;
    transition: transform 160ms ease;
  }
  .section-index__row:hover .section-index__title {
    color: var(--accent);
  }
  .section-index__row:hover .section-index__arrow {
    transform: translateX(3px);
  }
</style>
