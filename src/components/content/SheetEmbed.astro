---
interface Props {
  url: string;
  title: string;
  fallbackLabel: string;
}
const { url, title, fallbackLabel } = Astro.props;

let publishedSheet: URL;
try {
  publishedSheet = new URL(url);
} catch {
  throw new Error('SheetEmbed requires an absolute published Google Sheets URL.');
}
if (publishedSheet.hostname !== 'docs.google.com' || !publishedSheet.pathname.startsWith('/spreadsheets/d/e/')) {
  throw new Error('SheetEmbed only accepts published Google Sheets URLs.');
}

// Visible fallback link points at the human-viewable published sheet
// (strip the widget/embed query parameters).
const fallbackUrl = url.split('?')[0];
---

<div class="sheet">
  <iframe class="sheet__frame" src={url} title={title} loading="lazy" referrerpolicy="no-referrer"></iframe>
  <p class="sheet__fallback">
    <a href={fallbackUrl} target="_blank" rel="noopener noreferrer">{fallbackLabel}</a>
  </p>
</div>

<style>
  .sheet {
    margin: 24px 0 var(--sec-md);
  }
  .sheet__frame {
    display: block;
    width: 100%;
    height: 520px;
    border: 1px solid var(--rule);
    background: #fff;
  }
  .sheet__fallback {
    margin: 10px 0 0;
    font: var(--cta);
  }
  .sheet__fallback a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sheet__fallback a {
    transition: opacity 150ms ease;
  }
  .sheet__fallback a:hover {
    opacity: 0.72;
  }
</style>
