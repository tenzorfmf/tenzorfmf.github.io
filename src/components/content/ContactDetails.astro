---
import type { Locale } from '../../i18n/config';
import { org, site } from '../../utils/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const contact = org(locale).contact;
---

<div class="contact-rows">
  <a class="contact-row" href={`mailto:${contact.email}`}>
    <span class="contact-row__k">{locale === 'sl' ? 'E-pošta' : 'Email'}</span>
    <span class="contact-row__v">{contact.email}</span>
  </a>
  <a class="contact-row contact-row--last" href={site.social.instagram} target="_blank" rel="noopener noreferrer">
    <span class="contact-row__k">Instagram</span>
    <span class="contact-row__v">{contact.instagram}</span>
  </a>
</div>

<style>
  .contact-rows {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: 6px 0;
    margin-bottom: 24px;
  }
  .contact-row {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 150ms ease;
  }
  .contact-row--last { border-bottom: none; }
  .contact-row__k { font: 600 15px/1.3 var(--sans); }
  .contact-row__v { font: 400 14px/1.3 var(--sans); color: var(--accent); }
  .contact-row:hover { background: var(--tint); }
</style>
