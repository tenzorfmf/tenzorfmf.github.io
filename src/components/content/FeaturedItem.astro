---
interface Props {
  eyebrow: string;
  href: string;
  title: string;
  meta?: string;
  deck?: string;
  cta: string;
}
const { eyebrow, href, title, meta, deck, cta } = Astro.props;
---

<section class="featured" data-reveal style="--d: 0.3s">
  <div class="eyebrow eyebrow--accent">{eyebrow}</div>
  <a class="featured__card" href={href}>
    {meta && <div class="featured__meta">{meta}</div>}
    <div class="featured__title">{title}</div>
    {deck && <p class="featured__deck">{deck}</p>}
    <span class="featured__cta">{cta} <span aria-hidden="true">→</span></span>
  </a>
</section>

<style>
  .featured {
    margin-bottom: var(--sec-home);
  }
  .featured__card {
    display: block;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--magenta);
    padding: 14px 16px var(--row-featured);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 200ms ease;
  }
  .featured__card:hover {
    border-color: var(--ink);
    border-top-color: var(--magenta);
  }
  .featured__meta {
    font: 600 11px/1.3 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-60);
    margin-bottom: 6px;
  }
  .featured__title {
    font: var(--featured-home);
    text-wrap: pretty;
    margin-bottom: 8px;
  }
  .featured__deck {
    margin: 0 0 12px;
    font: 400 13.5px/1.6 var(--sans);
    color: var(--ink-80);
  }
  .featured__cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font: var(--cta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--magenta);
    padding-bottom: 2px;
  }
  .featured__cta span {
    transition: transform 160ms ease;
  }
  .featured__card:hover .featured__cta span {
    transform: translateX(3px);
  }
</style>
