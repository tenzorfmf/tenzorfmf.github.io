---
import type { Locale } from '../../i18n/config';
import { bcp47 } from '../../i18n/config';

interface Item {
  href: string;
  title: string;
  date: Date;
}
interface Props {
  eyebrow: string;
  locale: Locale;
  items: Item[];
}
const { eyebrow, locale, items } = Astro.props;
const fmt = new Intl.DateTimeFormat(bcp47[locale], {
  day: 'numeric',
  month: 'short',
});
// "20. jun." -> "20. JUN": uppercase and drop the abbreviation dot for the narrow date column.
const shortDate = (d: Date) => fmt.format(d).replace(/\.$/, '').toUpperCase();
---

{
  items.length > 0 && (
    <section class="latest" id="latest" data-reveal style="--d: 0.62s">
      <div class="eyebrow">{eyebrow}</div>
      <div class="latest__rows">
        {items.map((item) => (
          <a class="latest__row" href={item.href}>
            <span class="latest__date">
              <time datetime={item.date.toISOString().slice(0, 10)}>{shortDate(item.date)}</time>
            </span>
            <span class="latest__title">{item.title}</span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .latest {
    margin-bottom: var(--sec-home);
  }
  .latest__rows {
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }
  .latest__row {
    display: flex;
    gap: var(--gap-index-row);
    padding: var(--row-latest) 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .latest__row:last-child {
    border-bottom: none;
  }
  .latest__date {
    font: var(--latest-date);
    color: var(--ink-60);
    width: 52px;
    flex: none;
  }
  .latest__title {
    font: var(--latest-item);
    transition: color 150ms ease;
  }
  .latest__row:hover .latest__title {
    color: var(--accent);
  }
</style>
