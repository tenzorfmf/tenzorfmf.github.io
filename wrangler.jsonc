// Cloudflare Worker used only for branch Previews of the static build
// (production stays on GitHub Pages). See .github/workflows/preview-dev.yml.
{
  "name": "tenzor-fmf",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Required by `wrangler preview`; empty because the site has no bindings or vars.
  "previews": {}
}
