// Top level: production Worker (tenzor-fmf.org), deployed from `main` by
// Cloudflare Workers Builds with `npx wrangler deploy`.
// `env.dev`: dev Worker (dev.tenzor-fmf.org), deployed with
// `npx wrangler deploy --env dev`. Keep custom domains out of the top level so
// a build for one Worker can never claim the other's domain.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenzorfmf-github-io",
  "account_id": "2e62c15f5af47ec2ab7b0ad7084d1b7b",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "dev": {
      "name": "tenzor-fmf-dev",
      "routes": [{ "pattern": "dev.tenzor-fmf.org", "custom_domain": true }]
    }
  }
}
