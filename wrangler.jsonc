// Production Worker, deployed from `main` by Cloudflare Workers Builds. The
// dev workflow reuses this config with `--name tenzor-fmf-dev`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenzorfmf-github-io",
  "account_id": "2e62c15f5af47ec2ab7b0ad7084d1b7b",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
