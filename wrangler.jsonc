// Dev Worker (dev.tenzor-fmf.org). The name matches the Workers Builds
// connection for `tenzor-fmf-dev`. The custom domain is passed by the dev
// workflow, never set here, so production builds cannot claim it.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenzor-fmf-dev",
  "account_id": "2e62c15f5af47ec2ab7b0ad7084d1b7b",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
